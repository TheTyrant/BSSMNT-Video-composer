{
  "name": "bssmnt",
  "productName": "BSS MNT",
  "version": "0.1.0-alpha.1",
  "description": "BSS MNT — beat-locked video composer and DJ visualizer. Offline: renders, packs and exports on your machine.",
  "private": true,
  "main": "electron/main.js",
  "author": "Omar (TheTyrant); original by Waskar Paulino (traksaw)",
  "scripts": {
    "start": "node electron/run.js",
    "serve": "node serve.js",
    "dist:win": "electron-builder --win nsis portable zip --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.bssmnt.app",
    "productName": "BSS MNT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "output.html",
      "app/**",
      "styles/**",
      "vendor/**",
      "package.json",
      "electron/main.js",
      "electron/icon.png",
      "electron/preload.js",
      "electron/convert.js"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "electron/icon.png",
      "artifactName": "BSSMNT-alphaV1-win-x64.${ext}",
      "legalTrademarks": "BSS MNT"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BSS MNT",
      "artifactName": "BSSMNT-alphaV1-win-x64-Setup.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "portable": {
      "artifactName": "BSSMNT-alphaV1-win-x64-Portable.${ext}"
    },
    "copyright": "Copyright 2026 Omar (BSS MNT)",
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/README.txt"
      }
    ],
    "extraFiles": [
      {
        "from": "README-BSSMNT.txt",
        "to": "README-BSSMNT.txt"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheTyrant/BSSMNT-Video-composer.git"
  }
}
